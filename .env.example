# Public HubSpot form identifiers retained for local testing only.
# Never add private access tokens or other credentials to this file.
#
# Flutter reads the shared portal identifier only for the temporary direct
# registration transport. It does not read the Venue form identifier. The
# Worker uses HUBSPOT_PORTAL_ID and HUBSPOT_FORM_GUID in its own ignored
# cloudflare/venue-interest-worker/.dev.vars file; the Venue identifier remains
# here as a convenient local reference when preparing that Worker file.
FUN_APP_HUBSPOT_PORTAL_ID=123456789
FUN_APP_HUBSPOT_VENUE_FORM_GUID=00000000-0000-0000-0000-000000000000
#
# Here & Now and Founding Friend are only read by an explicitly configured
# development build for temporary direct-HubSpot testing. The committed fake
# Development (Fake Repositories) does not load this file. Development (Direct
# HubSpot) does load it, while production remains fail-closed until a
# first-party Worker transport is implemented.
FUN_APP_HUBSPOT_HERE_AND_NOW_FORM_GUID=00000000-0000-0000-0000-000000000000
FUN_APP_HUBSPOT_FOUNDING_FRIEND_FORM_GUID=00000000-0000-0000-0000-000000000000
