{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fun App Landing — Development (Fake Repositories)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "deviceId": "chrome",
      "flutterMode": "debug"
    },
    {
      "name": "Fun App Landing — Development (Direct HubSpot)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "deviceId": "chrome",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define-from-file=.env",
        "--dart-define=FUN_APP_REGISTRATION_TRANSPORT=direct_hubspot"
      ]
    },
    {
      "name": "Fun App Landing — Development (Local Worker)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "deviceId": "chrome",
      "flutterMode": "debug",
      "toolArgs": [
        "--web-port=7357",
        "--dart-define-from-file=.env",
        "--dart-define=FUN_APP_REGISTRATION_TRANSPORT=local_worker"
      ]
    },
    {
      "name": "Fun App Worker — Local Mock",
      "request": "launch",
      "type": "node-terminal",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/cloudflare/venue-interest-worker"
    },
    {
      "name": "Fun App Landing — Production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_prod.dart",
      "deviceId": "chrome",
      "flutterMode": "debug"
    }
  ],
  "compounds": [
    {
      "name": "Fun App Landing + Local Mock Worker",
      "configurations": [
        "Fun App Worker — Local Mock",
        "Fun App Landing — Development (Local Worker)"
      ],
      "stopAll": true
    }
  ]
}
