---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="FunApp | Coming Soon"
  description="FunApp is preparing something thoughtful. The public site is coming soon."
>
  <main class="relative flex min-h-[100svh] items-center justify-center overflow-hidden px-4 py-10 sm:px-6 lg:px-8">
    <div class="blob blob-left hidden md:block" aria-hidden="true"></div>
    <div class="blob blob-right hidden md:block" aria-hidden="true"></div>
    <div class="blob blob-bottom hidden lg:block" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(157,109,224,0.14),_transparent_34%)]" aria-hidden="true"></div>

    <section class="surface-card surface-card-strong relative z-10 mx-auto flex w-full max-w-3xl flex-col items-center rounded-[2rem] px-7 py-12 text-center sm:px-10 sm:py-14 lg:px-14 lg:py-16">
      <div class="eyebrow justify-center text-[rgba(245,239,231,0.66)]">
        <span class="eyebrow-line" aria-hidden="true"></span>
        <span>FunApp</span>
      </div>

      <h1 class="hero-display mt-8 text-balance text-[var(--text)]">
        <span class="block">Coming</span>
        <em class="mt-1 block font-normal italic text-[var(--blob-neutral)]">soon.</em>
      </h1>

      <p class="mx-auto mt-7 max-w-2xl text-base leading-8 text-[var(--muted)] sm:text-lg">
        We are refining the public experience with care. A more complete introduction to FunApp will be shared here soon.
      </p>

      <p class="mt-8 text-sm uppercase tracking-[0.22em] text-[rgba(245,239,231,0.46)]">
        Quietly in progress
      </p>
    </section>
  </main>
</BaseLayout>
