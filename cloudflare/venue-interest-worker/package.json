{
  "name": "funapp-venue-interest-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "wrangler:validate": "wrangler deploy --dry-run --env=\"\"",
    "wrangler:validate:staging": "wrangler deploy --dry-run --env staging"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.2",
    "typescript": "^7.0.2",
    "vitest": "4.1.12",
    "wrangler": "^4.136.2"
  }
}
