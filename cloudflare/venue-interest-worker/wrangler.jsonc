{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funapp-venue-interest",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  // HubSpot bindings are configured separately on the existing Worker.
  // Preserve dashboard-managed values when deploying code-only changes.
  "keep_vars": true,
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "REGISTRATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "name": "funapp-venue-interest-staging",
      "main": "src/staging.ts",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "STAGING_REGISTRATION_MOCK_ENABLED": "true"
      },
      "ratelimits": [
        {
          "name": "REGISTRATION_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
