{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funapp-founding-friend-payment",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "keep_vars": true,
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "PAYMENT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "name": "funapp-founding-friend-payment-staging",
      "main": "src/staging.ts",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "PAYMENT_CREATION_ENABLED": "false",
        "STRIPE_PRICE_ID": "STAGING_PRICE_ID_NOT_CONFIGURED",
        "STRIPE_EXPECTED_LIVEMODE": "false",
        "STRIPE_AUTOMATIC_TAX_ENABLED": "NOT_CONFIGURED",
        "PUBLIC_APP_ORIGIN": "https://staging.funapp.world"
      },
      "ratelimits": [
        {
          "name": "PAYMENT_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  }
}
