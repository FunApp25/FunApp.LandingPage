{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funapp-founding-friend-payment",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "keep_vars": true,
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "PAYMENT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
